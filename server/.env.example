# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# Port the server runs on (optional, defaults to 5000)
PORT=5000

# URL of the deployed client — used for CORS in production
# Leave unset in local development (localhost:5173 is allowed by default)
CLIENT_URL=https://your-client.onrender.com
